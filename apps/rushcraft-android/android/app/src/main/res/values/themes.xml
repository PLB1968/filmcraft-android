<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- the editor's dark surface, so nothing flashes before the first frame -->
    <color name="window_background">#FF000000</color>
    <!-- FilmCraft's violet, the app icon's field (assets/app-icon/README.md) -->
    <color name="ic_launcher_background">#FF8B5CF6</color>

    <style name="Theme.Rushcraft" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
